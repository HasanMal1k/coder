# Required
DATABASE_URL=postgres://coder:coder@localhost:5432/coder?sslmode=disable
JWT_SECRET=

# Optional; the values shown are the defaults.
PORT=8080
WORKSPACE_IMAGE=coder-workspace:dev
# Where machines dial the control plane. Must be reachable from inside a machine.
GUEST_CONNECT_URL=ws://host.docker.internal:8080/guest/connect
# Where the server listens for machines' link daemons (gRPC), and where
# machines dial it. Like GUEST_CONNECT_URL, the second must be reachable from
# inside a machine.
LINK_ADDR=:8081
LINK_CONNECT_URL=http://host.docker.internal:8081
# Comma-separated browser origins allowed to use the API: where the frontend is served.
CORS_ALLOWED_ORIGINS=http://coder.localhost:3000,http://localhost:3000
# Machines' ports are served at <port>-<instance id>.<WORKSPACE_HOST>. Keep it on
# the same site as the frontend (see docs/ARCHITECTURE.md).
WORKSPACE_HOST=coder.localhost:8080
WORKSPACE_SCHEME=http
# How long a sign-in lasts. 0 means until the user signs out: the token never
# expires, and can only be invalidated by changing JWT_SECRET, which signs
# everyone out. A duration such as 15m makes tokens short-lived; the app
# renews them while it is open.
ACCESS_TOKEN_TTL=0
# Stop a running machine once nobody has been connected to it for this long:
# its owner has closed the app and nothing is using its terminal or editor.
# A duration such as 2m or 90s; 0 turns it off.
IDLE_STOP_AFTER=2m

# The assistant. Without a key it is switched off; everything else works.
DEEPSEEK_API_KEY=
# Any OpenAI-compatible API whose model supports tool calling can be used.
LLM_BASE_URL=https://api.deepseek.com/v1
# The model to ask for, used by the assistant and by the coding agents alike.
# Which names a key can use differs; ask the provider:
#   curl -s $LLM_BASE_URL/models -H "Authorization: Bearer $DEEPSEEK_API_KEY"
LLM_MODEL=deepseek-chat
# The model's own limits, in tokens, given to the coding agents on new
# machines. Less than the model's real ones makes agents forget their work.
# The defaults are DeepSeek V4's.
LLM_CONTEXT_WINDOW=1000000
LLM_MAX_OUTPUT=384000
# How hard the model thinks for coding agents: low, high or max. Harder
# costs more output tokens.
AGENT_REASONING_EFFORT=max
